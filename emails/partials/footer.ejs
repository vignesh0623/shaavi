<%#
  Dark footer: contact details (inline blocks that wrap on narrow screens;
  one per line with the phone styles), why the email was sent, and the
  copyright.
  Locals: note; optional company { email, phone, address } and year.
%>
<%
  const font = "font-family:'Poppins',Arial,Helvetica,sans-serif;";
  const company = locals.company || {
    email: "info@shaavihealthcare.com",
    phone: "+44 1234 567890",
    address: "Hayes, London, United Kingdom",
  };
  const year = locals.year || new Date().getFullYear();
%>
<tr>
<td class="footer" bgcolor="#1b1b1b" style="padding:24px; background-color:#1b1b1b; border-top:1px solid #3d3d3d;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="font-size:0; line-height:0;">
<!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-right:8px;"><![endif]-->
<div class="footer-item" style="display:inline-block; padding-right:8px; vertical-align:top; <%= font %> font-size:12px; line-height:16px; white-space:nowrap;"><a href="mailto:<%= company.email %>" style="color:#0087c6; text-decoration:none;"><%= company.email %></a></div>
<!--[if mso]></td><td style="padding-right:20px;"><![endif]-->
<div class="footer-item" style="display:inline-block; padding-right:20px; vertical-align:top; <%= font %> font-size:12px; line-height:16px; white-space:nowrap;"><a href="tel:<%= company.phone.replace(/[^\d+]/g, "") %>" style="color:#bbbbbb; text-decoration:none;"><%= company.phone %></a></div>
<!--[if mso]></td><td><![endif]-->
<div class="footer-item" style="display:inline-block; vertical-align:top; <%= font %> font-size:12px; line-height:16px; color:#bbbbbb;"><%= company.address %></div>
<!--[if mso]></td></tr></table><![endif]-->
</td>
</tr>
<tr>
<td class="small" style="padding-top:12px; <%= font %> font-size:11px; line-height:16px; color:#767676;"><%= note %></td>
</tr>
<tr>
<td style="padding-top:12px; <%= font %> font-size:12px; line-height:16px; color:#767676;">&copy; <%= year %> Shaavi Healthcare. All rights reserved.</td>
</tr>
</table>
</td>
</tr>
