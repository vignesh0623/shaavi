<%#
  Pill button (Figma "Button Small"): a coloured table cell around the link,
  so Outlook keeps the colour (its corners stay square). An icon follows the
  label, or sits in a white chip when `chip` is set ("Call User").
  Locals: assetsUrl, href, label, background, icon (file in assetsUrl), chip.
%>
<% const font = "font-family:'Poppins',Arial,Helvetica,sans-serif;"; %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;">
<tr>
<td align="center" bgcolor="<%= background %>" style="border-radius:1000px; background-color:<%= background %>;">
<% if (locals.chip) { -%>
<a href="<%= href %>" target="_blank" style="display:inline-block; padding:7px 6px 7px 18px; <%= font %> font-size:13px; line-height:24px; color:#ffffff; text-decoration:none; text-transform:capitalize; white-space:nowrap; border-radius:1000px;"><%= label %><span style="display:inline-block; width:24px; height:24px; margin-left:6px; border-radius:12px; background-color:#ffffff; vertical-align:top; line-height:0; text-align:center;"><img src="<%= assetsUrl %>/<%= icon %>" width="12" height="12" alt="" style="display:inline-block; width:12px; height:12px; margin-top:6px; border:0;"></span></a>
<% } else { -%>
<a href="<%= href %>" target="_blank" style="display:inline-block; padding:11px 18px; <%= font %> font-size:13px; line-height:16px; color:#ffffff; text-decoration:none; text-transform:capitalize; white-space:nowrap; border-radius:1000px;"><%= label %><img src="<%= assetsUrl %>/<%= icon %>" width="16" height="16" alt="" style="display:inline-block; width:16px; height:16px; margin-left:6px; vertical-align:top; border:0;"></a>
<% } -%>
</td>
</tr>
</table>
